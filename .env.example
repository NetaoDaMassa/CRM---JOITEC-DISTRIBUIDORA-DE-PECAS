# ─── Odin CRM (Node) — Deploy via Docker Compose (Hostinger VPS) ──────────────
# Copie para .env e preencha:  cp .env.example .env

# Chave JWT — OBRIGATÓRIA. Gere uma forte com:
#   openssl rand -hex 32
JWT_SECRET=

# URL pública do CRM (com https://, SEM barra no final).
# É o mesmo domínio DuckDNS configurado no Caddyfile do projeto-leads.
# Ex.: https://grupoodin-crm.duckdns.org
CLIENT_URL=https://SEU-SUBDOMINIO.duckdns.org
