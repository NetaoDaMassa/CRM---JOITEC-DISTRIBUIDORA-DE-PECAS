# ─── Joitec CRM (Node) — Deploy via Docker Compose (Hostinger VPS) ────────────
# Copie para .env e preencha:  cp .env.example .env

# Chave JWT — OBRIGATÓRIA. Gere uma forte com:
#   openssl rand -hex 32
JWT_SECRET=

# URL pública do CRM (com https://, SEM barra no final).
# É o subdomínio DuckDNS que você vai adicionar ao Caddyfile do projeto-leads.
# Ex.: https://joitec-crm.duckdns.org
CLIENT_URL=https://joitec-crm.duckdns.org

# Opcional — extração automática dos itens do PDF do pedido via IA.
# Se deixar vazio, o CRM funciona normalmente, só sem esse recurso.
# Gere em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opcional — integração GoTo Connect (registro automático de ligações).
# Se deixar vazio, o botão "Conectar com a GoTo" em Configurações fica
# indisponível, mas o resto do CRM funciona normal.
# GOTO_CLIENT_ID/SECRET vêm do app cadastrado em https://developer.goto.com/
# GOTO_REDIRECT_URI precisa estar cadastrado como "redirect URI" autorizado
# nesse mesmo app do GoTo — ex.: https://joitec-crm.duckdns.org/api/goto/callback
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
GOTO_REDIRECT_URI=
