# ─── Joitec CRM (Node) — Deploy via Docker Compose (Hostinger VPS) ────────────
# Copie para .env e preencha:  cp .env.example .env

# Chave JWT — OBRIGATÓRIA. Gere uma forte com:
#   openssl rand -hex 32
JWT_SECRET=

# URL pública do CRM (com https://, SEM barra no final).
# É o subdomínio DuckDNS que você vai adicionar ao Caddyfile do projeto-leads.
# Ex.: https://joitec-crm.duckdns.org
CLIENT_URL=https://joitec-crm.duckdns.org

# Opcional — extração automática dos itens do PDF do pedido via IA.
# Se deixar vazio, o CRM funciona normalmente, só sem esse recurso.
# Gere em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opcional — integração GoTo Connect (registro automático de ligações).
# Se deixar vazio, o botão "Conectar com a GoTo" em Configurações fica
# indisponível, mas o resto do CRM funciona normal.
# GOTO_CLIENT_ID/SECRET vêm do app cadastrado em https://developer.goto.com/
# GOTO_REDIRECT_URI precisa estar cadastrado como "redirect URI" autorizado
# nesse mesmo app do GoTo — ex.: https://joitec-crm.duckdns.org/api/goto/callback
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
GOTO_REDIRECT_URI=

# Opcional — ponte com o CRM de marketing (odin-tubos-crm), pra mostrar no
# Painel de TV quantos leads "Novo" cada vendedor tem esperando atendimento.
# MARKETING_CRM_URL: domínio público do outro CRM (com https://, sem barra no
# final) — ex.: https://grupoodin-crm.duckdns.org
# MARKETING_CRM_API_KEY: precisa ser IGUAL ao INTEGRATIONS_API_KEY configurado
# no .env do odin-tubos-crm.
# Se deixar vazio, o slide "Leads aguardando" some sozinho do painel.
MARKETING_CRM_URL=
MARKETING_CRM_API_KEY=

# Opcional — pedido de arte/vídeo aprovado (aba "Solicitar Design" do
# vendedor) cai sozinho numa base do Notion, pro marketing ver sem entrar
# no CRM. Se deixar vazio, a aprovação funciona normal, só não sincroniza.
# NOTION_API_KEY: "Internal Integration Secret" criado em
# notion.so/my-integrations (começa com "secret_" ou "ntn_").
# NOTION_DATABASE_ID_DESIGN: ID da base do Notion (compartilhada com essa
# integração via "..." → Connections na própria base) — vem no meio do link
# dela, ex: notion.so/<ESSE_ID_AQUI>?v=...
NOTION_API_KEY=
NOTION_DATABASE_ID_DESIGN=
# Vídeo é outra base (e integração/token) separada — outro time cuidando.
# Mesmo formato de coluna da de Design (Nome/Data/STATUS/EMPRESA).
NOTION_API_KEY_VIDEO=
NOTION_DATABASE_ID_DESIGN_VIDEO=

# Opcional — recebe os webhooks do WooCommerce da loja online da Compretec
# Loja Física (carrinho abandonado + cadastro novo), que viram lead pros
# vendedores dessa empresa. WOOCOMMERCE_COMPRETEC_WEBHOOK_SECRET precisa ser
# IGUAL ao "Segredo" configurado no wp-admin em WooCommerce > Configurações >
# Avançado > Webhooks. Se deixar vazio, os webhooks chegam mas são rejeitados
# (o resto do CRM funciona normal).
WOOCOMMERCE_COMPRETEC_WEBHOOK_SECRET=

# Opcional — busca periodicamente (a cada 5min) os carrinhos abandonados
# captados pelo plugin "WooCommerce Abandoned Cart Recovery Premium"
# (Recarto) no WordPress da loja online da Compretec Loja Física, via um
# endpoint REST pequeno instalado no functions.php do tema (ver instruções
# passadas ao João, 2026-09-17). Pega quem preenche o checkout mesmo sem
# finalizar a compra — volume bem maior que o WOOCOMMERCE_COMPRETEC_WEBHOOK_SECRET
# acima, que só reage a pedido de verdade. Se deixar vazio, esse recurso
# fica desligado sozinho (o resto do CRM funciona normal).
# WOOCOMMERCE_COMPRETEC_SITE_URL: domínio da loja, com https://, sem barra
# no final — ex.: https://compretec.com.br
# WOOCOMMERCE_COMPRETEC_EXPORT_SECRET: precisa ser IGUAL à senha configurada
# no snippet do WordPress.
WOOCOMMERCE_COMPRETEC_SITE_URL=
WOOCOMMERCE_COMPRETEC_EXPORT_SECRET=

# Opcional — captação de leads via Instagram Direct (comentário com
# palavra-chave → private reply; primeira mensagem direta → boas-vindas).
# UM Meta App só, compartilhado por todas as empresas (cada uma conecta a
# própria conta profissional via OAuth em Configurações > Integração
# Instagram). Se deixar essas variáveis vazias, o recurso fica desabilitado
# (o resto do CRM funciona normal). Ver server/src/lib/instagramApi.ts.
#
# INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET: do App criado em
# developers.facebook.com (produto "Instagram" + "Webhooks" configurados).
# IMPORTANTE — não é só copiar e colar: pra funcionar com conta de EMPRESA
# CLIENTE de verdade (não só a sua própria conta de desenvolvedor), o App
# precisa passar por App Review e Verificação de Negócio no painel da Meta —
# isso é 100% manual, feito lá no site da Meta, não dá pra automatizar por
# aqui. Sem isso, só funciona com contas de teste/desenvolvedor adicionadas
# manualmente no App.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN: qualquer string que você escolher — cola ela
# também no campo "Verify Token" ao cadastrar a URL do webhook no painel do
# App (Products > Webhooks > Instagram).
INSTAGRAM_VERIFY_TOKEN=
# URL completa do callback OAuth (com https://) — precisa estar cadastrada
# como "Valid OAuth Redirect URI" no painel do App (Facebook Login).
# Ex.: https://joitec-crm.duckdns.org/api/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Chave de 32 bytes em base64 (gerar com: openssl rand -base64 32) — usada
# pra criptografar o token de página de cada empresa antes de salvar no
# banco (nunca fica em texto puro). Trocar essa chave depois de já ter
# empresa conectada invalida os tokens salvos (precisam reconectar).
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# ─── Aviso amigável de leads novos no WhatsApp ───────────────────────────────
# Lembrete 2x por dia (dias úteis, fuso America/Sao_Paulo) pra cada vendedor
# da Joitec com leads parados na etapa "Novo" do funil. Só leitura no funil —
# não move nem marca nada. Detalhes: server/src/lib/avisoLeadsNovos.ts

# LIGA/DESLIGA tudo. Enquanto for "false", não agenda nada e não sobe sessão
# de WhatsApp. Coloque "true" só depois de parear o QR e testar em dry run.
AVISO_LEADS_ENABLED=false

# "true" = monta as mensagens e escreve no log, mas NÃO envia. É assim que se
# testa antes de soltar pro time.
AVISO_LEADS_DRY_RUN=false

# "true" = manda TODAS as mensagens pro AVISO_LEADS_TEST_NUMERO (abaixo), em
# vez de mandar pra cada vendedor. Segunda camada de conferência.
AVISO_LEADS_TEST_MODE=false

# Número (só dígitos, com 55) que recebe tudo no modo de teste E o resumo do
# gestor (leads sem vendedor, vendedores sem número, falhas de envio).
AVISO_LEADS_TEST_NUMERO=5547997008385

# Opcional — número do resumo do gestor, se for diferente do de teste.
# Vazio = usa o AVISO_LEADS_TEST_NUMERO.
AVISO_LEADS_ADMIN_NUMERO=

# Os 2 horários, "HH:MM,HH:MM". O 1º usa o tom de manhã (planejar o dia), o
# 2º o tom de fim de tarde ("dá tempo de falar com alguns antes de sair").
AVISO_LEADS_HORARIOS=08:00,17:30

# Empresa cujo funil é lido (1 = Joitec Distribuidora de Peças).
AVISO_LEADS_EMPRESA_ID=1

# Intervalo aleatório (ms) entre um envio e o outro, pra não disparar tudo no
# mesmo segundo.
AVISO_LEADS_MIN_INTERVALO_MS=3000
AVISO_LEADS_MAX_INTERVALO_MS=5000
