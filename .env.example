# ─── Joitec CRM (Node) — Deploy via Docker Compose (Hostinger VPS) ────────────
# Copie para .env e preencha:  cp .env.example .env

# Chave JWT — OBRIGATÓRIA. Gere uma forte com:
#   openssl rand -hex 32
JWT_SECRET=

# URL pública do CRM (com https://, SEM barra no final).
# É o subdomínio DuckDNS que você vai adicionar ao Caddyfile do projeto-leads.
# Ex.: https://joitec-crm.duckdns.org
CLIENT_URL=https://joitec-crm.duckdns.org

# Opcional — extração automática dos itens do PDF do pedido via IA.
# Se deixar vazio, o CRM funciona normalmente, só sem esse recurso.
# Gere em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opcional — integração GoTo Connect (registro automático de ligações).
# Se deixar vazio, o botão "Conectar com a GoTo" em Configurações fica
# indisponível, mas o resto do CRM funciona normal.
# GOTO_CLIENT_ID/SECRET vêm do app cadastrado em https://developer.goto.com/
# GOTO_REDIRECT_URI precisa estar cadastrado como "redirect URI" autorizado
# nesse mesmo app do GoTo — ex.: https://joitec-crm.duckdns.org/api/goto/callback
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
GOTO_REDIRECT_URI=

# Opcional — ponte com o CRM de marketing (odin-tubos-crm), pra mostrar no
# Painel de TV quantos leads "Novo" cada vendedor tem esperando atendimento.
# MARKETING_CRM_URL: domínio público do outro CRM (com https://, sem barra no
# final) — ex.: https://grupoodin-crm.duckdns.org
# MARKETING_CRM_API_KEY: precisa ser IGUAL ao INTEGRATIONS_API_KEY configurado
# no .env do odin-tubos-crm.
# Se deixar vazio, o slide "Leads aguardando" some sozinho do painel.
MARKETING_CRM_URL=
MARKETING_CRM_API_KEY=

# ─── Aviso amigável de leads novos no WhatsApp ───────────────────────────────
# Lembrete 2x por dia (dias úteis, fuso America/Sao_Paulo) pra cada vendedor
# da Joitec com leads parados na etapa "Novo" do funil. Só leitura no funil —
# não move nem marca nada. Detalhes: server/src/lib/avisoLeadsNovos.ts

# LIGA/DESLIGA tudo. Enquanto for "false", não agenda nada e não sobe sessão
# de WhatsApp. Coloque "true" só depois de parear o QR e testar em dry run.
AVISO_LEADS_ENABLED=false

# "true" = monta as mensagens e escreve no log, mas NÃO envia. É assim que se
# testa antes de soltar pro time.
AVISO_LEADS_DRY_RUN=false

# "true" = manda TODAS as mensagens pro AVISO_LEADS_TEST_NUMERO (abaixo), em
# vez de mandar pra cada vendedor. Segunda camada de conferência.
AVISO_LEADS_TEST_MODE=false

# Número (só dígitos, com 55) que recebe tudo no modo de teste E o resumo do
# gestor (leads sem vendedor, vendedores sem número, falhas de envio).
AVISO_LEADS_TEST_NUMERO=5547997008385

# Opcional — número do resumo do gestor, se for diferente do de teste.
# Vazio = usa o AVISO_LEADS_TEST_NUMERO.
AVISO_LEADS_ADMIN_NUMERO=

# Os 2 horários, "HH:MM,HH:MM". O 1º usa o tom de manhã (planejar o dia), o
# 2º o tom de fim de tarde ("dá tempo de falar com alguns antes de sair").
AVISO_LEADS_HORARIOS=08:00,17:30

# Empresa cujo funil é lido (1 = Joitec Distribuidora de Peças).
AVISO_LEADS_EMPRESA_ID=1

# Intervalo aleatório (ms) entre um envio e o outro, pra não disparar tudo no
# mesmo segundo.
AVISO_LEADS_MIN_INTERVALO_MS=3000
AVISO_LEADS_MAX_INTERVALO_MS=5000
