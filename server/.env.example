DATABASE_URL=file:./joitec_crm.db
JWT_SECRET=joitec_crm_super_secret_jwt_key_change_in_production
PORT=3001
UPLOADS_DIR=./uploads
CLIENT_URL=http://localhost:5173

# Extração de itens do PDF do pedido via IA (server/src/lib/pdfExtraction.ts)
ANTHROPIC_API_KEY=

# Aviso de leads novos no WhatsApp (ver .env.example na raiz do repo pra
# explicação de cada campo). Deixe AVISO_LEADS_ENABLED=false até parear o QR.
AVISO_LEADS_ENABLED=false
AVISO_LEADS_DRY_RUN=false
AVISO_LEADS_TEST_MODE=false
AVISO_LEADS_TEST_NUMERO=
AVISO_LEADS_ADMIN_NUMERO=
AVISO_LEADS_HORARIOS=08:00,17:30
AVISO_LEADS_EMPRESA_ID=1
AVISO_LEADS_MIN_INTERVALO_MS=3000
AVISO_LEADS_MAX_INTERVALO_MS=5000
WA_SESSION_DIR=./wa-session
